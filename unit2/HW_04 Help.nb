Cell["\<\
Question 3
\tCreate a contour map and a streamplot of a \[PlusMinus]5C dipole separate \
by 10 cm, centered on a region  -10 cm < x < 10 cm and -10 cm < y < 10 cm, \
that looks similar to the figure 7.31.   
\
\>", "Text",
 CellChangeTimes->{{3.892165356273091*^9, 
  3.8921653625856247`*^9}},ExpressionUUID->"3c6c03e6-cc02-45a3-a325-\
7f3f6f61f6b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q1", "=", 
   RowBox[{"-", "5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q2", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X1", "=", 
   RowBox[{"-", "0.05"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X2", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y1", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y2", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "[", 
   RowBox[{"x_", ",", "xp_", ",", "y_", ",", "yp_"}], "]"}], " ", ":=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "xp"}], ")"}], "^", "2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"y", "-", "yp"}], ")"}], "^", "2"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ex", "[", 
    RowBox[{"q_", ",", "x_", ",", "xp_", ",", "y_", ",", "yp_"}], "]"}], ":=", 
   RowBox[{"coulombConstant", "*", "q", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "xp"}], ")"}], "/", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"x", ",", "xp", ",", "y", ",", "yp"}], "]"}], "^", "3"}]}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ey", "[", 
    RowBox[{"q_", ",", "x_", ",", "xp_", ",", "y_", ",", "yp_"}], "]"}], ":=", 
   RowBox[{"coulombConstant", "*", "q", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"y", "-", "yp"}], ")"}], "/", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"x", ",", "xp", ",", "y", ",", "yp"}], "]"}], "^", "3"}]}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Extot", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Ex", "[", 
     RowBox[{"Q1", ",", "x", ",", "X1", ",", "y", ",", "Y1"}], "]"}], "+", 
    RowBox[{"Ex", "[", 
     RowBox[{"Q2", ",", "x", ",", "X2", ",", "y", ",", "Y2"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Eytot", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Ey", "[", 
     RowBox[{"Q1", ",", "x", ",", "X1", ",", "y", ",", "Y1"}], "]"}], "+", 
    RowBox[{"Ey", "[", 
     RowBox[{"Q2", ",", "x", ",", "X2", ",", "y", ",", "Y2"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"q_", ",", "x_", ",", "xp_", ",", "y_", ",", "yp_"}], "]"}], ":=", 
   RowBox[{"coulombConstant", "*", 
    RowBox[{"q", "/", 
     RowBox[{"r", "[", 
      RowBox[{"x", ",", "xp", ",", "y", ",", "yp"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Vtot", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{"Q1", ",", "x", ",", "X1", ",", "y", ",", "Y1"}], "]"}], "+", 
    RowBox[{"V", "[", 
     RowBox[{"Q2", ",", "x", ",", "X2", ",", "y", ",", "Y2"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"as", "=", 
   RowBox[{"VectorPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Extot", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"Eytot", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}], ",", 
     RowBox[{"VectorColorFunction", "->", "\"\<Rainbow\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bs", "=", 
   RowBox[{"StreamPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Extot", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"Eytot", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs", "=", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"Vtot", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", ".10"}], ",", ".10"}], "}"}], ",", 
     RowBox[{"Contours", "\[Rule]", "9"}], ",", 
     RowBox[{"ContourShading", "\[Rule]", "None"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"cs", ",", "bs"}], "]"}]}], "Input",
 CellChangeTimes->{{3.892160052566176*^9, 3.892160246135212*^9}, {
