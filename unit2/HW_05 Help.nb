Notebook[{
Cell[TextData[{
 "Question 1 \nThe electric potential in a region of space is given by V=100(",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "99430bbe-267d-40bc-97ec-bff341577452"],
 "-",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "9774b7d3-dee3-4055-891a-ef15022eb056"],
 " in volts, where x and y are in meters.\na)       Draw a contour map of the \
potential, showing and labeling the -400 V, -100 V, 0 V, +100 V , and +400 V \
equipotential surfaces.\nb)        Find an expression for the electric field ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["E", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "0d2b7618-b6aa-445e-8c2c-7f90333ef2b6"],
 " at position (x,y).\n\tE = -dV = -d(100(x^2-y^2)) = 100 * -(2x - 2y) = \
200y-200x\nc)\tDraw the electric field lines on your diagram of part a.\n"
}], "Text",
 CellChangeTimes->{{3.8926894752341275`*^9, 3.892689569743373*^9}, {
   3.8926897514655867`*^9, 3.892689845045524*^9}, 3.892690812120983*^9, {
   3.89269085866033*^9, 3.8926908607366953`*^9}, {4.0008981064058475`*^9, 
   4.0008981068032627`*^9}, {4.0008981873895054`*^9, 
   4.0008982091068993`*^9}, {4.0008982477334023`*^9, 
   4.0008982955899467`*^9}, {4.000898343763218*^9, 
   4.000898344475006*^9}},ExpressionUUID->"0c5f16f1-4402-4fd9-ab7e-\
5d850e8397d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"100", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "-", 
        RowBox[{"y", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"V", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"Contours", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "400"}], ",", 
        RowBox[{"-", "100"}], ",", "0", ",", "100", ",", "400"}], "}"}]}], 
     " ", ",", 
     RowBox[{"ContourLabels", "\[Rule]", "True"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
