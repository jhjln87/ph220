Cell["\<\
Question 2
Charge is uniformly distributed with a density of 100.0 \[Mu]C/m3 throughout \
the volume of a cube 10.00 cm on each edge.
a)\t Find the electric potential at a distance of 5.000 cm from the center of \
one face of the cube, measured along a perpendicular to the face. Determine \
the potential to four significant figures. Use a numerical method that \
divides the cube into a sufficient number of smaller cubes, treated as point \
charges.  (Note:  use a value of k = 8.98755 x 109 N m2/C2)
\tkq / r
b)\tIf the charge in the cube is redistributed into a uniform sphere of \
charge with the same center, by how much does the potential change?
\
\>", "Text",
 CellChangeTimes->{{3.892690282115433*^9, 3.892690308205722*^9}, {
  4.000898518766514*^9, 4.0008985196139336`*^9}, {4.0008991533511715`*^9, 
  4.0008991695063114`*^9}, {4.0008994835805416`*^9, 
  4.0008994846057014`*^9}},ExpressionUUID->"af0a4c42-816f-4c2a-9475-\
332928def17e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"coulombsConstant", "=", 
     RowBox[{"8.98755", "*", 
      RowBox[{"10", "^", "9"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xp", "=", ".1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rho", "=", 
     RowBox[{"100", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", ".1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dl", "=", 
     RowBox[{"L", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vol", "=", 
     RowBox[{"dl", "^", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dq", "=", 
     RowBox[{"rho", "*", "Vol"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"start", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "L"}], "/", "2"}], " ", "+", " ", 
      RowBox[{"dl", "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", 
      RowBox[{"x_", ",", "y_", ",", "z_", ",", "xp_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "xp"}], ")"}], "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}], "+", 
       RowBox[{"z", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"V", "[", "r_", "]"}], ":=", 
     RowBox[{"coulombsConstant", " ", "*", " ", 
      RowBox[{"dq", " ", "/", "r"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vp", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"k", "=", "1"}], ",", 
      RowBox[{"k", "<=", "n"}], ",", 
      RowBox[{"k", "=", 
       RowBox[{"k", "+", "1"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "n"}], ",", 
        RowBox[{"i", "=", 
         RowBox[{"i", "+", "1"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "<=", "n"}], ",", 
          RowBox[{"j", "=", 
           RowBox[{"j", "+", "1"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "=", 
              RowBox[{"start", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}], "*", "dl"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"y", "=", 
              RowBox[{"start", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}], "*", "dl"}]}]}], ";"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"z", "=", 
             RowBox[{"start", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}], "*", "dl"}]}]}], ";"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dist", "=", 
            RowBox[{"r", "[", 
             RowBox[{"x", ",", "y", ",", "z", ",", "xp"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Vp", "=", 
            RowBox[{"Vp", "+", 
             RowBox[{"V", "[", "dist", "]"}]}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", "Vp", "\[IndentingNewLine]", 
   RowBox[{"Vpt", "=", 
    RowBox[{"coulombsConstant", " ", "*", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"rho", " ", "*", " ", 
        RowBox[{"L", "^", "3"}]}], ")"}], "/", "xp"}]}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.892643984788389*^9, 3.8926439871069045`*^9}, {
   3.892644022292242*^9, 3.8926441108839254`*^9}, {3.892644210146129*^9, 
   3.89264424326295*^9}, {3.8926443353584757`*^9, 3.892644441581234*^9}, {
