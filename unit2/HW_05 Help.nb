   3.8926846241337767`*^9}, {3.892684704277943*^9, 3.8926847081524115`*^9}, {
   3.892684740634364*^9, 3.8926848876142244`*^9}, 3.892684918023799*^9, {
   3.8926849677244124`*^9, 3.892684974205412*^9}, {3.8926851340243406`*^9, 
