   3.8926454405951567`*^9}, {3.892645488936077*^9, 3.8926455819468155`*^9}, {
   3.8926456910344706`*^9, 3.8926457144462376`*^9}, {3.8926483035133953`*^9, 
   3.892648367804205*^9}, {3.8926484469599347`*^9, 3.892648475240507*^9}, 
   3.892648866758225*^9, {3.8926594369029303`*^9, 3.8926594396429777`*^9}, {
